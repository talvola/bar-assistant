# One-shot test runner — builds an image that runs phpunit and exits.
# Not for production; not committed by default.
#
# Usage (via Portainer build endpoint):
#   POST /api/endpoints/3/docker/build?t=bar-assistant:flavor-test&dockerfile=Dockerfile.test
#   POST /api/endpoints/3/docker/containers/create?name=ba-flavor-test
#     {"Image": "bar-assistant:flavor-test", "HostConfig": {"AutoRemove": true}}
#   POST /api/endpoints/3/docker/containers/ba-flavor-test/start
#   GET  /api/endpoints/3/docker/containers/ba-flavor-test/logs?stdout=1&stderr=1
FROM serversideup/php:8.4-fpm-nginx AS test

USER root

RUN install-php-extensions bcmath intl ffi

RUN apt update \
    && apt-get install -y sqlite3 git \
    && apt-get install -y --no-install-recommends libvips42 \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN mkdir -p /var/www/cocktails && chown -R www-data:www-data /var/www/cocktails

USER www-data
WORKDIR /var/www/cocktails

COPY --chown=www-data:www-data composer.json composer.lock ./
# WITH dev dependencies — phpunit + factories + faker
RUN composer install --optimize-autoloader --no-scripts

COPY --chown=www-data:www-data . .
RUN composer dump-autoload --optimize && cp .env.testing .env

# Force Scout to no-op for isolated testing — no Meilisearch dependency.
ENV SCOUT_DRIVER=null

# Default command: migrate + run the Flavor tests. Override with `docker run`
# args if you want to run other test filters.
CMD php artisan key:generate --force && \
    php artisan test --filter=FlavorController
