# Production image, non-BuildKit variant of the upstream Dockerfile.
# Identical result to `Dockerfile` target=dist, but replaces COPY --chmod/--chown
# (BuildKit-only) with plain COPY + root RUN chmod/chown, so it builds via the
# Portainer build API (which doesn't enable BuildKit).
#
# Build: target not needed (single dist stage here).
FROM serversideup/php:8.4-fpm-nginx AS php-base

LABEL org.opencontainers.image.source="https://github.com/karlomikus/bar-assistant"
LABEL org.opencontainers.image.description="Bar assistant is a all-in-one solution for managing your home bar"
LABEL org.opencontainers.image.licenses=MIT

ENV S6_CMD_WAIT_FOR_SERVICES=1
ENV APP_BASE_DIR=/var/www/cocktails
ENV NGINX_WEBROOT=/var/www/cocktails/public

USER root

RUN install-php-extensions bcmath intl ffi

RUN apt update \
    && apt-get install -y \
    sqlite3 git \
    && apt-get install -y --no-install-recommends libvips42 \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR ${APP_BASE_DIR}

FROM php-base AS dist

ENV PHP_OPCACHE_ENABLE=1
ENV PHP_OPCACHE_MAX_ACCELERATED_FILES=20000
ENV PHP_OPCACHE_MEMORY_CONSUMPTION=256
ARG BAR_ASSISTANT_VERSION=develop
ENV BAR_ASSISTANT_VERSION=${BAR_ASSISTANT_VERSION}
ENV LOG_OUTPUT_LEVEL=error
ENV NGINX_FASTCGI_BUFFERS="16 16k"
ENV NGINX_FASTCGI_BUFFER_SIZE="32k"

# Stay root through the COPY+chmod/chown sequence (no BuildKit --chmod/--chown).
USER root

COPY ./resources/docker/dist/init.sh /etc/entrypoint.d/99-bass.sh
COPY ./resources/docker/dist/nginx.conf /etc/nginx/server-opts.d/99-bass.conf
COPY ./resources/docker/dist/php.ini /usr/local/etc/php/conf.d/zzz-bass-php.ini
RUN chmod 755 /etc/entrypoint.d/99-bass.sh /etc/nginx/server-opts.d/99-bass.conf \
    && chown www-data:www-data /etc/nginx/server-opts.d/99-bass.conf

RUN mkdir -p ${APP_BASE_DIR} && chown -R www-data:www-data ${APP_BASE_DIR}

COPY composer.json composer.lock ./
RUN chown www-data:www-data composer.json composer.lock

USER www-data
RUN composer install --optimize-autoloader --no-dev --no-scripts

USER root
COPY . .
ADD "https://github.com/bar-assistant/data.git" ./resources/data
RUN chown -R www-data:www-data ${APP_BASE_DIR}

USER www-data
RUN composer dump-autoload --optimize \
    && sed -i "s/{{VERSION}}/$BAR_ASSISTANT_VERSION/g" ./docs/openapi-generated.yaml \
    && cp .env.dist .env

USER root
RUN docker-php-serversideup-s6-init

USER www-data

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD php-fpm-healthcheck || exit 1

VOLUME ["$APP_BASE_DIR/storage/bar-assistant"]
